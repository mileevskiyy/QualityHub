# npm start loads .env automatically. Never commit a populated .env file.
PORT=3100
DATA_DIR=data
SEED_DEMO=true
# Optional: use an existing PostgreSQL database instead of local SQLite.
# DATABASE_URL=postgresql://qualityhub:CHANGE_ME@127.0.0.1:5432/qualityhub
# For compose.yaml, choose a URL-safe password before starting the stack.
# POSTGRES_PASSWORD=CHANGE_ME
# For an HTTPS deployment, configure both:
# NODE_ENV=production
# APP_ORIGIN=https://your-domain.example
